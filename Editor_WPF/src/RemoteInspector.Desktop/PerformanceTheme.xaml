<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PerformanceButton" TargetType="Button">
        <Setter Property="Foreground" Value="#C5D3E3"/><Setter Property="Background" Value="#263344"/>
        <Setter Property="BorderBrush" Value="#384A60"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#35475E"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#1D507A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PerformancePrimaryButton" TargetType="Button" BasedOn="{StaticResource PerformanceButton}"><Setter Property="Background" Value="#245A82"/><Setter Property="BorderBrush" Value="#3479AB"/><Setter Property="Foreground" Value="#F4FAFF"/></Style>
    <Style x:Key="PerformanceInput" TargetType="TextBox"><Setter Property="Background" Value="#141D29"/><Setter Property="Foreground" Value="#D4DFED"/><Setter Property="BorderBrush" Value="#2C3C50"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="FontSize" Value="12"/><Setter Property="SelectionBrush" Value="#346B9A"/></Style>
    <Style x:Key="PerformanceTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="#91A5BE"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,6,5"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#C1E3FF"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#65B9F3"/><Setter TargetName="Chrome" Property="Background" Value="#203449"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#26374A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PerformanceGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="#19232F"/><Setter Property="Foreground" Value="#D1DEEC"/><Setter Property="RowBackground" Value="#19232F"/><Setter Property="AlternatingRowBackground" Value="#1C2836"/>
        <Setter Property="BorderThickness" Value="0"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeight" Value="30"/><Setter Property="ColumnHeaderHeight" Value="28"/><Setter Property="FontSize" Value="12"/><Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#223042"/><Setter Property="Foreground" Value="#91A9C3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,4"/><Setter Property="FontWeight" Value="Normal"/></Style></Setter.Value></Setter>
        <Setter Property="CellStyle"><Setter.Value><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,4"/><Setter Property="Foreground" Value="#D1DEEC"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#274966"/><Setter Property="Foreground" Value="#EAF6FF"/></Trigger></Style.Triggers></Style></Setter.Value></Setter>
    </Style>

    <Style x:Key="WorkspaceNavigation" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#91A9C3"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinWidth" Value="128"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="3,0"/><Setter Property="Padding" Value="16,4"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Chrome" Background="#182535" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#254F77"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#5AB4F4"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Chrome" Property="Background" Value="#293D53"/><Setter Property="Foreground" Value="#E3EFFC"/></MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#9BD7FF"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
