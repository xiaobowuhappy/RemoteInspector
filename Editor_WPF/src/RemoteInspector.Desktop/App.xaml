<Application x:Class="RemoteInspector.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Surface" Color="#202733"/>
        <SolidColorBrush x:Key="Text" Color="#E6EDF5"/>
        <Style TargetType="Window"><Setter Property="Background" Value="#141A23"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="13"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="#DDE8F4"/><Setter Property="Foreground" Value="#142335"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="3"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/><Setter Property="Foreground" Value="#142335"/></Style>
        <Style TargetType="TabControl"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style TargetType="TabItem"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="12,7"/><Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="#142335"/></DataTemplate></Setter.Value></Setter></Style>
        <Style TargetType="DataGrid"><Setter Property="Background" Value="#F5F8FC"/><Setter Property="Foreground" Value="#142335"/><Setter Property="RowBackground" Value="#FFFFFF"/><Setter Property="AlternatingRowBackground" Value="#EDF2F8"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="RowDetailsVisibilityMode" Value="Collapsed"/></Style>
        <Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="2"/><Setter Property="IsExpanded" Value="False"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="8,4"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    </Application.Resources>
</Application>
