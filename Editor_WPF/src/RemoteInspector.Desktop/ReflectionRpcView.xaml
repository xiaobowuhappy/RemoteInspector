<UserControl x:Class="RemoteInspector.Desktop.ReflectionRpcView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:RemoteInspector.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#141D29" Foreground="#D4DFED" FontFamily="Microsoft YaHei UI" FontSize="12">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/RemoteInspector;component/PerformanceTheme.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style TargetType="Button" BasedOn="{StaticResource PerformanceButton}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource PerformanceInput}"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#B5C7DB"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="2"/><Setter Property="Padding" Value="6"/><Setter Property="Foreground" Value="#19283B"/></Style>
    </ResourceDictionary></UserControl.Resources>
    <DockPanel x:Name="BrowserRoot" Margin="16" Background="#141D29">
        <DockPanel x:Name="BrowserHeader" DockPanel.Dock="Top" Margin="0,0,0,6"><StackPanel><TextBlock Text="类与方法" FontSize="17" FontWeight="SemiBold" Foreground="#E5F1FE"/><TextBlock x:Name="ConnectionInfo" Margin="0,2,0,0"/></StackPanel><TextBlock Text="手动刷新 · 会话缓存 · 主线程调用" Foreground="#7392AF" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="2,0,2,6">
            <Button DockPanel.Dock="Right" Content="☆ 收藏当前调用" Click="SaveCallFavorite_Click" ToolTip="保存当前方法与参数到本地"/>
            <Expander x:Name="CallFavoritesPanel" IsExpanded="False" Foreground="#9DB6D0" HorizontalContentAlignment="Stretch">
                <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="调用收藏" FontWeight="SemiBold"/><TextBlock x:Name="FavoriteCount" Text=" · 0" Foreground="#7392AF"/><TextBlock Text=" · 本地保存" Foreground="#7392AF" Margin="8,0,0,0"/></StackPanel></Expander.Header>
                <DockPanel Margin="0,5,0,3"><Button DockPanel.Dock="Right" Content="移除" Click="RemoveCallFavorite_Click"/><Button DockPanel.Dock="Right" Content="载入" Click="LoadCallFavorite_Click"/><ComboBox x:Name="CallFavorites" DisplayMemberPath="Label" MinWidth="180" ToolTip="选择已收藏的方法，点击载入；不会自动执行" DropDownOpened="CallFavorites_Opened"/></DockPanel>
            </Expander>
        </DockPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Text="点击刷新目录获取远端程序集与类；打开窗口不会发出请求。" TextWrapping="Wrap" Margin="3,5,3,0" Foreground="#8EB5D5"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Background="#1B2837" Margin="0,0,4,0">
                <DockPanel DockPanel.Dock="Top" Margin="6"><Button x:Name="RefreshDirectory" Content="刷新目录" DockPanel.Dock="Right" Click="RefreshDirectory_Click"/><TextBlock Text="01  程序集 / 类" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                <ComboBox x:Name="AssemblyPicker" DockPanel.Dock="Top" DisplayMemberPath="Label" SelectionChanged="Assembly_Changed"/>
                <TextBox x:Name="ClassSearch" DockPanel.Dock="Top" Margin="5" TextChanged="ClassSearch_Changed" ToolTip="模糊搜索缓存类；点击刷新目录将关键字发送远端，最多返回 500 类"/>
                <TextBlock x:Name="ClassCount" DockPanel.Dock="Bottom" Margin="8" Foreground="#7F9CB8"/>
                <DataGrid x:Name="TypesGrid" local:SearchHighlight.Query="{Binding Text, ElementName=ClassSearch}" Style="{StaticResource PerformanceGrid}" IsReadOnly="True" SelectionChanged="Type_Selected" SelectionMode="Single"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Description}"/></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTemplateColumn Header="类 / 命名空间" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock local:SearchHighlight.Text="{Binding Name}" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="4" Background="#304155" HorizontalAlignment="Center"/>
            <DockPanel Grid.Column="2" Background="#1B2837" Margin="4,0">
                <DockPanel DockPanel.Dock="Top" Margin="6"><Button x:Name="RefreshMethods" Content="刷新方法" DockPanel.Dock="Right" Click="RefreshMethods_Click"/><TextBlock Text="02  方法" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                <DockPanel DockPanel.Dock="Top"><Button DockPanel.Dock="Right" Content="×" Click="ClearMethodSearch_Click" ToolTip="清除方法筛选" Padding="8,3"/><TextBox x:Name="MethodSearch" Margin="5" TextChanged="MethodSearch_Changed" ToolTip="按方法名、参数类型模糊搜索已缓存的方法；切换类时自动清除"/></DockPanel>
                <TextBlock x:Name="MethodCount" DockPanel.Dock="Bottom" Margin="8" Foreground="#7F9CB8" TextWrapping="Wrap"/>
<Grid>                <DataGrid x:Name="MethodsGrid" local:SearchHighlight.Query="{Binding Text, ElementName=MethodSearch}" Style="{StaticResource PerformanceGrid}" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Method_Selected"><DataGrid.Columns><DataGridTemplateColumn Header="完整签名（重载独立选择）" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock local:SearchHighlight.Text="{Binding Signature}" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Reason}"/><Style.Triggers><DataTrigger Binding="{Binding Callable}" Value="False"><Setter Property="Opacity" Value="0.45"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle></DataGrid><TextBlock x:Name="MethodEmptyState" Text="选择业务类开始查找" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="15" Foreground="#7896B2" IsHitTestVisible="False"/></Grid>
            </DockPanel>
            <GridSplitter Grid.Column="3" Width="4" Background="#304155" HorizontalAlignment="Center"/>
            <Grid Grid.Column="4" Margin="4,0,0,0"><Grid.RowDefinitions><RowDefinition Height="1.8*"/><RowDefinition Height="6"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel><DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0"><Button x:Name="Execute" Content="执行方法" Style="{StaticResource PerformancePrimaryButton}" Click="Execute_Click" DockPanel.Dock="Right"/><TextBlock Text="Ctrl + Enter 执行" VerticalAlignment="Center" Foreground="#7392AF" Margin="4"/></DockPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="03  参数与执行" FontWeight="SemiBold" Margin="4,6"/>
                    <TextBlock x:Name="SelectedSignature" Text="选择左侧方法" TextWrapping="Wrap" Margin="4,5" Foreground="#A6D9FF"/>
                    <StackPanel x:Name="InstanceOptions" Visibility="Collapsed"><DockPanel><Button x:Name="RefreshInstances" Content="刷新实例" DockPanel.Dock="Right" Click="RefreshInstances_Click"/><ComboBox x:Name="InstancePicker" DisplayMemberPath="Label" MinWidth="100"/></DockPanel>
                    <WrapPanel><CheckBox x:Name="IncludeInactive" Content="含未激活" Foreground="#9CB0C7" Margin="4,5"/><CheckBox x:Name="IncludeOtherScenes" Content="含其他场景 / 常驻" Foreground="#9CB0C7" Margin="4,5"/></WrapPanel></StackPanel>
                    <TextBlock x:Name="ParameterHeading" Text="参数" Margin="4,8,4,4"/>
                    <StackPanel x:Name="ParameterEditors"/>
                    <CheckBox x:Name="JsonMode" Content="直接编辑 JSON 数组" Foreground="#9CB0C7" Margin="4,7" Checked="JsonMode_Changed" Unchecked="JsonMode_Changed"/>
                    <TextBox x:Name="ArgumentsJson" Text="[]" IsReadOnly="True" TextChanged="Arguments_Changed" AcceptsReturn="True" MinHeight="38" MaxHeight="120" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                    <TextBlock x:Name="Validation" Foreground="#EDB082" TextWrapping="Wrap" Margin="4"/>
                    
                </StackPanel></ScrollViewer></DockPanel>
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#304155"/>
                <DockPanel Grid.Row="2"><DockPanel DockPanel.Dock="Top"><Button Content="复制结果" DockPanel.Dock="Right" Click="CopyResult_Click"/><TextBlock x:Name="Timing" Text="执行结果" VerticalAlignment="Center" Margin="4" Foreground="#7CD6BD" TextWrapping="Wrap"/></DockPanel><TextBox x:Name="Result" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/></DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
